# CareerMatch AI Environment Variables Specification
# Use this template to configure your local development or Render production environment.

# Application Environment (development | production)
APP_ENV="development"

# Server Port (Default: 3000)
PORT="3000"

# Google Gemini API Key (Get yours from https://aistudio.google.com/app/apikey)
# The application degrades gracefully with clear messaging when unset.
GEMINI_API_KEY=""

# Google Gemini Model Name (Default: gemini-2.0-flash)
GEMINI_MODEL="gemini-2.0-flash"

# Database Configuration (Neon PostgreSQL in production; SQLite local fallback)
# For Neon PostgreSQL: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""
DATABASE_PATH="careermatch.db"

# JWT Authentication Secret (MUST be at least 32 characters in production)
# In production (APP_ENV=production), the server will refuse to start if this is default or < 32 chars.
JWT_SECRET="replace-with-at-least-32-character-secure-random-secret"
JWT_EXPIRY_HOURS="72"

# Security & Data Retention Configuration
# Guest session data retention TTL in days before automated purging (Default: 30)
GUEST_DATA_TTL_DAYS="30"

# Secret Key for Private /api/health Diagnostics (leave blank to expose only minimal {"status":"ok"})
HEALTH_KEY="optional-private-health-diagnostics-key"

# CORS Allowed Origins (comma-separated, e.g. "https://careermatch.ai,https://staging.careermatch.ai")
# If empty in production, strict same-origin is enforced.
CORS_ORIGINS=""

# Optional GitHub Personal Access Token (prevents rate-limiting on public portfolio checks)
GITHUB_TOKEN=""

# Optional Live Job Market API Keys
# ADZUNA_APP_ID=""
# ADZUNA_APP_KEY=""
