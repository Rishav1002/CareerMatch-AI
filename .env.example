# Google Gemini API Key (Get yours from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Google Gemini Model Name
GEMINI_MODEL="gemini-2.5-flash"

# Database Configuration (SQLite default; set MYSQL_HOST or DATABASE_URL to use MySQL 8+)
DATABASE_PATH="careermatch.db"
DATABASE_URL=""
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="careermatch_ai"

# JWT Authentication Secret
JWT_SECRET="replace-with-strong-random-jwt-secret"
JWT_EXPIRY_HOURS="72"

# Optional GitHub Personal Access Token (increases public GitHub REST API rate limits)
GITHUB_TOKEN=""

# Server Port (Default: 3000)
PORT="3000"

