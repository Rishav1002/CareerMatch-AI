# Google Gemini API Key (Get yours from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Google Gemini Model Name
GEMINI_MODEL="gemini-2.5-flash"

# Database Configuration (SQLite default; set DATABASE_URL for Neon PostgreSQL)
DATABASE_PATH="careermatch.db"
DATABASE_URL=""

# JWT Authentication Secret
JWT_SECRET="replace-with-strong-random-jwt-secret"
JWT_EXPIRY_HOURS="72"

# Optional GitHub Personal Access Token (increases public GitHub REST API rate limits)
GITHUB_TOKEN=""

# Server Port (Default: 3000)
PORT="3000"

